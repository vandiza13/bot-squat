# ==========================================================
# SQUAT-MS TELEGRAM BOT - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================================

# 1. Telegram Bot Token (Dapatkan dari @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# 2. PostgreSQL Database URL (Supabase Connection Pooler IPv4)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.your_project_ref:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# 3. Telegram User ID Admin (Pisahkan dengan koma jika lebih dari 1 admin)
ADMIN_IDS=12345678

# 4. Google Apps Script Web App URL (Untuk Sinkronisasi Google Sheets /sync)
GAS_WEBAPP_URL=https://script.google.com/macros/s/your_deployment_id/exec

# 5. Spreadsheet IDs (Default Sheet Squad MS & Sheet BTS Witel)
SPREADSHEET_ID=your_spreadsheet_id_here
WITEL_SPREADSHEET_ID=your_witel_spreadsheet_id_here
